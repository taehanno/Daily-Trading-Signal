# 로컬 테스트용 환경변수 예시. 복사해서 .env 로 사용하거나 셸에 export.
# (.env 자동 로드는 안 됨 — 셸에서 export 하거나 Render 대시보드에 입력)

# --- 필수 (텔레그램) ---
TELEGRAM_BOT_TOKEN=123456:ABC-여기에_봇토큰
TELEGRAM_CHAT_ID=123456789

# --- 분석 대상 ---
# COINS 지정 시 해당 코인만, 비우면 거래대금 상위 TOP_N 자동
# COINS=BTC,ETH,XRP,SOL,DOGE
TOP_N=15
QUOTE=KRW
CANDLE_INTERVAL=1h

# --- 스케줄 ---
CHECK_INTERVAL_MIN=60
DAILY_SUMMARY_HOUR=9

# --- 알림 정책 ---
ALERT_MODE=on_change
ALERT_ON_HOLD=false

# --- 테스트 ---
# DRY_RUN=true   # 텔레그램 발송 대신 콘솔 출력
# ONESHOT=true   # 1회 분석 후 종료
